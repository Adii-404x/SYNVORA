
SUPABASE_URL=your_supabase_project_url
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
# Optional; reserved for server-side audit logging only. Never use in the browser.
# SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
# Optional cloud AI provider; when set, the API uses Groq instead of local Ollama.
# GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.8:27b
PORT=3000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
# Optional admin key, used only by the explicitly guarded demo seed command.
# Never put a secret key in a VITE_* variable or commit it.
# SUPABASE_SECRET_KEY=sb_secret_replace-with-demo-project-key
# DEMO_EMAIL=demo@example.test
# DEMO_PASSWORD=replace-with-a-demo-only-password-of-at-least-12-characters
# DEMO_PROJECT_REF_CONFIRM=replace-with-the-demo-project-ref
# Optional local directory or URL for English Tesseract traineddata.
# If unset, Tesseract.js uses its default traineddata location.
# TESSERACT_LANG_PATH=
